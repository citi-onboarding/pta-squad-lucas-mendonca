// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  ROMANCE
  INFANTIL
  TECNOLOGIA
  HISTORIA
  CIENCIAS
}

enum LoanStatus {
  EM_ANDAMENTO
  DEVOLVIDO
  ATRASADO
}

model Book {
  id                   String       @id @default(uuid())
  title                String
  autor                String
  isbn                 String
  publisher            String
  year                 Int
  totalQuantity        Int
  avaliableQuantity    Int
  category             Category
  // Relacionamento
  loans                Loan[]
}

model Loan {
  id                    String           @id @default(uuid())
  
  bookId               String
  book                 Book            @relation(fields: [bookId], references: [id])
  customerName         String
  customerEmail        String
  loanDate             DateTime @default(now())
  dueDate              DateTime
  status               LoanStatus @default(EM_ANDAMENTO)
}